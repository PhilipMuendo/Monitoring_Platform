# Copy to backend/.env and run the binary from this directory:
#
#     cd backend && go run ./cmd/server
#
# The server reads ./.env at startup (override the path with ENV_FILE).
# The PROCESS ENVIRONMENT ALWAYS WINS over this file, so it can only fill
# gaps -- a container or systemd unit is unaffected by whatever is here.
# Docker Compose does NOT read this file; it reads the repo-root .env.
#
# Syntax: KEY=VALUE, # starts a comment, `export ` prefixes are ignored.
# Quote any value containing a space-preceded # (`X="a #b"`), otherwise
# everything from " #" onward is treated as a comment. A # with no space
# before it -- as in a password like pa#ssword -- is kept as-is.
# A malformed line aborts boot naming the line number rather than being
# skipped: losing one key silently is the failure this loader exists to end.

# Server
PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=solar_admin
DB_PASSWORD=solar_dev_password
DB_NAME=solar_monitor
DB_SSLMODE=disable
MIGRATIONS_PATH=./migrations
# Pool size. Blank derives it from COLLECTOR_MAX_CONCURRENCY x the number
# of configured brands, plus headroom for API handlers, rather than a
# static guess that can starve request handlers while the collector is
# mid-cycle.
DB_MAX_CONNS=

# Auth
# JWT_SECRET signs access tokens. The server refuses to boot with the
# placeholder value unless SECURE_COOKIES=false marks this as a local run.
JWT_SECRET=change_me_in_production
# JWT_KEY_ID names the active signing key inside the token header, which is
# what makes rotation possible without logging everyone out: publish the new
# secret under a new id, move the old pair into JWT_PREVIOUS_KEYS, wait one
# JWT_ACCESS_TTL, then delete it.
JWT_KEY_ID=default
# Retired keys, verify-only. Format: id1:secret1,id2:secret2
JWT_PREVIOUS_KEYS=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Marks the refresh cookie Secure. Leave on everywhere except plain-HTTP
# local development — the failure mode of the safe setting is a broken
# localhost login; the unsafe setting ships a session cookie in plaintext.
SECURE_COOKIES=true
# Failed-login throttle. Checked before bcrypt runs, so it defends CPU as
# well as passwords.
LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW=5m
LOGIN_LOCKOUT=15m
ADMIN_SEED_EMAIL=admin@solarfleet.local
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Fleet Admin

# Collection
POLL_INTERVAL=5m
# Bounds one cycle so a wedged vendor API can't hold it open past the next
# tick and stack cycles. Blank derives it from POLL_INTERVAL.
COLLECTOR_TIMEOUT=
# In-flight per-site requests within a single brand. Bounds BOTH the vendor
# API fetch (adapters fetch their plants this many at a time) and the database
# fan-out that follows it. This is the knob that decides how long a cycle
# takes: vendor round-trip latency dominates everything else, so at 100 sites
# the difference between 1 and 10 here is the difference between a cycle of
# several minutes and one of well under a minute. Raise with care — these are
# the vendor's APIs and the installer account is shared.
COLLECTOR_MAX_CONCURRENCY=10
DAYTIME_START_HOUR=6
DAYTIME_END_HOUR=18

# Observability
# Exposes Prometheus metrics at /metrics. Unauthenticated by design (a
# scraper has no session) — bind it internally or restrict it at the proxy.
METRICS_ENABLED=true

# Inverter portal credentials. Every reading the platform stores comes from
# one of these APIs, so at least one brand must be filled in or the server
# exits at boot. A brand whose credentials are blank is skipped entirely —
# only fill in the brands you are actually integrated with.

# Deye
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_USERNAME=
DEYE_PASSWORD=
DEYE_REGION=eu

# Ingecon (X-API-KEY generated at ingeconsunmonitor.com > user menu > API Access)
INGECON_API_KEY=
INGECON_BASE_URL=https://www.ingeconsunmonitor.com

# Sosen (portal login at sosen.inteless.com; the JSON API lives at pv.inteless.com)
SOSEN_USERNAME=
SOSEN_PASSWORD=

# AI chat widget (optional). Get a free-tier key at aistudio.google.com/apikey.
# Left blank, /api/v1/chat returns 503 and the widget shows a "not configured"
# state — the rest of the platform is unaffected.
# GEMINI_MODEL must be a model the key can actually CALL. Pinned ids get
# retired: gemini-1.5-flash is gone, and gemini-2.5-flash returns "no longer
# available to new users". The -latest alias survives a retirement, which is
# why it is the default.
#
# Note the models endpoint advertises models a key cannot call, so listing is
# not enough — verify with a real request:
#   curl -s -o /dev/null -w "%{http_code}\n" \
#     "https://generativelanguage.googleapis.com/v1beta/models/$GEMINI_MODEL:generateContent?key=$GEMINI_API_KEY" \
#     -H "Content-Type: application/json" -d '{"contents":[{"parts":[{"text":"hi"}]}]}'
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
