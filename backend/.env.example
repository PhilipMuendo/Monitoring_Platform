# Server
PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=solar_admin
DB_PASSWORD=solar_dev_password
DB_NAME=solar_monitor
DB_SSLMODE=disable
MIGRATIONS_PATH=./migrations

# Auth
# JWT_SECRET signs access tokens. The server refuses to boot with the
# placeholder value unless SECURE_COOKIES=false marks this as a local run.
JWT_SECRET=change_me_in_production
# JWT_KEY_ID names the active signing key inside the token header, which is
# what makes rotation possible without logging everyone out: publish the new
# secret under a new id, move the old pair into JWT_PREVIOUS_KEYS, wait one
# JWT_ACCESS_TTL, then delete it.
JWT_KEY_ID=default
# Retired keys, verify-only. Format: id1:secret1,id2:secret2
JWT_PREVIOUS_KEYS=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Marks the refresh cookie Secure. Leave on everywhere except plain-HTTP
# local development — the failure mode of the safe setting is a broken
# localhost login; the unsafe setting ships a session cookie in plaintext.
SECURE_COOKIES=true
# Failed-login throttle. Checked before bcrypt runs, so it defends CPU as
# well as passwords.
LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW=5m
LOGIN_LOCKOUT=15m
ADMIN_SEED_EMAIL=admin@solarfleet.local
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Fleet Admin

# Collection
POLL_INTERVAL=5m
# Bounds one cycle so a wedged vendor API can't hold it open past the next
# tick and stack cycles. Blank derives it from POLL_INTERVAL.
COLLECTOR_TIMEOUT=
# In-flight per-site requests within a single brand.
COLLECTOR_MAX_CONCURRENCY=10
DAYTIME_START_HOUR=6
DAYTIME_END_HOUR=18

# Observability
# Exposes Prometheus metrics at /metrics. Unauthenticated by design (a
# scraper has no session) — bind it internally or restrict it at the proxy.
METRICS_ENABLED=true

# Inverter portal credentials. Every reading the platform stores comes from
# one of these APIs, so at least one brand must be filled in or the server
# exits at boot. A brand whose credentials are blank is skipped entirely —
# only fill in the brands you are actually integrated with.

# Deye
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_USERNAME=
DEYE_PASSWORD=
DEYE_REGION=eu

# Ingecon (X-API-KEY generated at ingeconsunmonitor.com > user menu > API Access)
INGECON_API_KEY=
INGECON_BASE_URL=https://www.ingeconsunmonitor.com

# Sosen (portal login at sosen.inteless.com; the JSON API lives at pv.inteless.com)
SOSEN_USERNAME=
SOSEN_PASSWORD=
