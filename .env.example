# Read by docker-compose.yml (the ${VAR:-default} interpolations) for the
# Docker Compose quickstart. This is separate from backend/.env.example and
# frontend/.env.example, which are for running each service outside Docker.
#
#   cp .env.example .env
#   docker compose up --build

# Database
DB_USER=solar_admin
DB_PASSWORD=solar_dev_password
DB_NAME=solar_monitor

# Auth
# The backend refuses to boot with this placeholder unless SECURE_COOKIES
# is false, so it's safe as a local default. Set a real random value before
# ever setting SECURE_COOKIES=true.
JWT_SECRET=change_me_in_production
JWT_KEY_ID=default
# Retired signing keys, verify-only. Format: id1:secret1,id2:secret2
JWT_PREVIOUS_KEYS=

# Compose runs over plain HTTP on localhost, so a Secure cookie would never
# be sent back and login would silently fail. Set to true (and set a real
# JWT_SECRET) behind TLS.
SECURE_COOKIES=false

METRICS_ENABLED=true
POLL_INTERVAL=5m
COLLECTOR_MAX_CONCURRENCY=10
# Pool size. Blank derives it from COLLECTOR_MAX_CONCURRENCY x the number
# of configured brands, plus headroom for API handlers.
DB_MAX_CONNS=
LOG_LEVEL=info

# Inverter portal credentials. A brand left blank is skipped; with all
# three blank the backend exits at boot naming the variables it needs.

# Deye
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_USERNAME=
DEYE_PASSWORD=
DEYE_REGION=eu

# Ingecon (X-API-KEY generated at ingeconsunmonitor.com > user menu > API Access)
INGECON_API_KEY=
INGECON_BASE_URL=https://www.ingeconsunmonitor.com

# Sosen (portal login at sosen.inteless.com; the JSON API lives at pv.inteless.com)
SOSEN_USERNAME=
SOSEN_PASSWORD=

CORS_ALLOWED_ORIGIN=http://localhost:3000

# Inlined into the frontend's client bundle at build time (see
# frontend/Dockerfile) — changing this after the image is built requires
# `docker compose up --build frontend`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8080
